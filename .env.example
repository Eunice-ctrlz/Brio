# Base URL of the PHP REST API. Use a relative path to go through the Vite dev proxy,
# or an absolute URL (e.g. https://api.example.com/api) when the API is on another origin.
VITE_API_URL=/api

# "true" serves built-in demo data (no backend needed). Set to "false" to call the PHP API.
VITE_USE_MOCK=true

# Dev-only: where the Vite proxy forwards /api (read by vite.config.ts)
PHP_API_TARGET=http://localhost:8000

